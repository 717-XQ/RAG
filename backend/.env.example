# ============================================================
# RAG智能文档问答系统 - 环境变量模板
# 复制为 .env 并填入真实值（config.yaml 中留空 api_key 的项由这里补齐）
# ============================================================

# ---------- LLM API Key（多Provider自动降级，技术栈2.1） ----------
# DeepSeek（default provider，优先）
DEEPSEEK_API_KEY=
# 阿里云百炼 DashScope 通义千问（降级 provider）
DASHSCOPE_API_KEY=
# OpenAI（通用兼容接口）
# OPENAI_API_KEY=

# ---------- 认证（技术栈2.1：JWT） ----------
# 生产环境务必设置为随机长字符串
# JWT_SECRET=your-random-secret

# ---------- 关系数据库（技术栈2.1） ----------
# MySQL示例: mysql+pymysql://root:密码@127.0.0.1:3306/rag_kb?charset=utf8mb4
# PostgreSQL示例: postgresql+psycopg2://user:pass@localhost:5432/rag_kb
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/rag_kb?charset=utf8mb4

# ---------- 其他（可选） ----------
# 自定义LLM API Base URL（单Provider场景兼容旧配置）
# LLM_BASE_URL=https://api.deepseek.com/v1
