# ============================================================
# RAG智能文档问答系统 - 环境变量配置模板
# ============================================================
# 使用方式：
#   1. 复制本文件为 .env
#   2. 填入你的配置信息
#   3. 系统启动时会自动加载 .env 文件
# ============================================================

# OpenAI API Key（必填）
# 【需手动填写】请在此处填入你的API Key
OPENAI_API_KEY=your_api_key_here

# 可选：自定义API Base URL
# 使用OpenAI官方: https://api.openai.com/v1
# 使用DeepSeek:   https://api.deepseek.com/v1
# 使用通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BASE_URL=https://api.openai.com/v1
